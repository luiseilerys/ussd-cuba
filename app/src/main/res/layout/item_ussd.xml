<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="3dp"
    app:cardElevation="0dp"
    app:cardCornerRadius="14dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainer"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorOutlineVariant"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:id="@+id/rootCol"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCodeBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnPrimary"
            android:background="?attr/colorPrimary"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone"
            android:includeFontPadding="false" />

        <View
            android:id="@+id/accentTop"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="?attr/colorPrimary"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/bodyRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="4dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <View
                android:id="@+id/accentBar"
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_accent_bar"
                android:minHeight="36dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvCodeSide"
                android:layout_width="88dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:padding="6dp"
                android:gravity="center"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:background="@drawable/bg_code_chip"
                android:maxLines="3"
                android:ellipsize="end"
                android:visibility="gone"
                android:includeFontPadding="false" />

            <LinearLayout
                android:id="@+id/textCol"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/tvDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:alpha="0.92" />

                <TextView
                    android:id="@+id/tvCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    android:background="@drawable/bg_code_chip"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCodePlain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="4dp"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:textColor="?attr/colorPrimary"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone"
                android:includeFontPadding="false" />

            <ImageButton
                android:id="@+id/btnFavorite"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_star_outline"
                android:contentDescription="Favorito"
                android:padding="10dp"
                android:scaleType="centerInside" />
        </LinearLayout>

        <View
            android:id="@+id/rowDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_divider"
            android:visibility="gone" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
